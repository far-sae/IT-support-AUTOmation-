# ─── Core ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# ─── Database (Postgres) ──────────────────────────────────────────────
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay?schema=public

# ─── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── AI triage + autopilot brain (Anthropic) ─────────────────────────
USE_AI_TRIAGE=false
USE_AI_BRAIN=false
ANTHROPIC_API_KEY=
BRAIN_MODEL=claude-haiku-4-5-20251001
BRAIN_MAX_ITERATIONS=6
AUTOPILOT_INTERVAL_MINUTES=1

# ─── SMTP (Mailpit in dev) ────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Relay Support <support@relay.local>"

# ─── IMAP (inbound email — optional) ──────────────────────────────────
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_TLS=true
IMAP_POLL_SECONDS=60
IMAP_DEFAULT_ORG_SLUG=

# ─── OAuth: Google ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── OAuth: Microsoft ─────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Base URL used to assemble OAuth callbacks (e.g. http://localhost:4000)
OAUTH_CALLBACK_BASE_URL=http://localhost:4000

# ─── Object storage (MinIO in dev) ────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=relay-attachments
S3_ACCESS_KEY=relayminio
S3_SECRET_KEY=relayminio
S3_FORCE_PATH_STYLE=true

# ─── Scheduled jobs ───────────────────────────────────────────────────
SLA_CHECK_INTERVAL_MINUTES=5
AGENT_STALE_MINUTES=15

# ─── Phase 11 — Closed-loop autopilot ─────────────────────────────────
# Default Slack incoming webhook (per-org override via Organization.settings.slackWebhookUrl)
SLACK_WEBHOOK_URL=
# GitHub PAT with `workflow` scope, used by github_dispatch + co-pilot button
GITHUB_TOKEN=
# Morning brief cron (platform-level default; per-org override in settings)
DAILY_BRIEF_CRON=0 8 * * *

# ─── Phase 12 — Detection + event bus ─────────────────────────────────
DETECTION_INTERVAL_MINUTES=5

# Optional Kafka mirror — every event bus message is published when set
KAFKA_BROKERS=
KAFKA_CLIENT_ID=relay-server
KAFKA_TOPIC_PREFIX=relay.

# Optional Elasticsearch — ticket search + event mirror + log shipping
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX_PREFIX=relay
ELASTICSEARCH_LOGS_PREFIX=relay-logs

# ─── Phase 13 — Workflow executor ─────────────────────────────────────
WORKFLOW_TICK_MINUTES=1

# ─── Phase 14 — Infrastructure actions ────────────────────────────────
TERRAFORM_BIN=terraform
ANSIBLE_BIN=ansible-playbook
TERRAFORM_DEFAULT_WORKDIR=
# Vendor-neutral firewall API token (PaloAlto / pfSense / generic)
FIREWALL_API_TOKEN=
# ITSM bridges
SERVICENOW_API_TOKEN=
JIRA_API_TOKEN=

# ─── Phase 15 — Telemetry exporters (optional, env-gated) ─────────────
# Splunk HTTP Event Collector
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
SPLUNK_HEC_INDEX=

# CloudWatch — Logs + Metrics (creds via the default AWS SDK chain)
CLOUDWATCH_LOG_GROUP=
CLOUDWATCH_LOG_STREAM=relay-server
CLOUDWATCH_METRICS_NAMESPACE=
CLOUDWATCH_METRICS_INTERVAL_SECONDS=60
AWS_REGION=us-east-1

# Azure Monitor Data Collector
AZURE_MONITOR_WORKSPACE_ID=
AZURE_MONITOR_SHARED_KEY=
AZURE_MONITOR_LOG_TYPE=RelayServer

# ─── Phase 16 — ML training ───────────────────────────────────────────
ML_TRAIN_CRON=0 3 * * *

# ─── Phase 17 — OPA (Open Policy Agent) ───────────────────────────────
OPA_URL=
OPA_DECISION_PATH=relay/allow
